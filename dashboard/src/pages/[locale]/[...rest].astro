---
import Base from "../../layouts/Base.astro";
import HostPage from "../../views/host-page";
import JobsPage from "../../views/jobs-page";
import LabPage from "../../views/lab-page";
import HealthPage from "../../views/health-page";
import ContributePage from "../../views/contribute-page";
import FeedbackPage from "../../views/feedback-page";
import { ContentInfoPage } from "../../views/content-info-page";
import { LegalDocPage, LegalIndexPage } from "../../views/legal-page";
import { OverviewPage, AnalyticsPage, ConsolePage, ProvidersPage, SitemapPage, WorkflowsPage } from "../../views/android/pages";
import { LEGAL_DOCS, rewriteLinks } from "../../lib/legal";
import { FIREWALL_LOCALES, type FirewallLocale } from "../../firewall/locale";
import * as contributing from "../../../../CONTRIBUTING.md";

const files = import.meta.glob<{ compiledContent: () => Promise<string> }>("../../../../docs/legal/*.md", { eager: true });
const labs = ["android", "windows", "linux", "ios", "macos"] as const;

export function getStaticPaths() {
  const labs = ["android", "windows", "linux", "ios", "macos"];
  const androidPages = ["", "analytics", "console", "providers", "sitemap", "workflows"];
  const routes = ["", "jobs", "contribute", "feedback", "content", "health", "legal", ...LEGAL_DOCS.map((doc) => `legal/${doc.slug}`), ...labs.map((lab) => `labs/${lab}`), ...androidPages.map((page) => page ? `android/${page}` : "android")];
  return FIREWALL_LOCALES.filter((locale) => locale !== "en").flatMap((locale) =>
    routes.map((rest) => ({ params: { locale, rest } }))
  );
}

const locale = Astro.params.locale as FirewallLocale;
const rest = Astro.params.rest ?? "";
const doc = LEGAL_DOCS.find((item) => rest === `legal/${item.slug}`);
const entry = doc && Object.entries(files).find(([path]) => path.endsWith(`/${doc.file}`));
const legalHtml = entry ? rewriteLinks(await entry[1].compiledContent()) : "";
const contributeHtml = rest === "contribute" ? rewriteLinks(await contributing.compiledContent(), "") : "";
const contentFiles = import.meta.glob<{ compiledContent: () => Promise<string> }>("../../../../docs/CONTENT.md", { eager: true });
const contentHtml = rest === "content" ? rewriteLinks(await Object.values(contentFiles)[0].compiledContent(), "docs") : "";
const lab = rest.startsWith("labs/") ? rest.slice(5) as typeof labs[number] : null;
const labTitle: Record<typeof labs[number], string> = { android: "Android Lab · Runtime & setup", windows: "Windows Lab", linux: "Linux Lab", ios: "iOS Lab", macos: "macOS Lab" };
const androidTitle: Record<string, string> = { android: "Android Lab", "android/analytics": "Android Lab · Analytics", "android/console": "Android Lab · Console", "android/providers": "Android Lab · Providers", "android/sitemap": "Android Lab · Sitemap", "android/workflows": "Android Lab · Workflows" };
const title = rest === "" ? "This computer" : rest === "jobs" ? "Jobs" : rest === "contribute" ? "Contribute" : rest === "feedback" ? "Feedback" : rest === "content" ? "Content updates" : rest === "health" ? "Health check" : doc ? doc.title : rest === "legal" ? "Legal" : lab ? labTitle[lab] : androidTitle[rest] ?? "os-lab";
---
<Base title={title} description={doc?.description} lang={locale}>
  {rest === "" && <HostPage client:only="react" />}
  {rest === "jobs" && <JobsPage client:only="react" />}
  {rest === "contribute" && <ContributePage html={contributeHtml} client:only="react" />}
  {rest === "feedback" && <FeedbackPage client:only="react" />}
  {rest === "content" && <ContentInfoPage html={contentHtml} client:only="react" />}
  {rest === "health" && <HealthPage client:only="react" />}
  {rest === "legal" && <LegalIndexPage client:only="react" />}
  {doc && <LegalDocPage slug={doc.slug} html={legalHtml} client:only="react" />}
  {lab && <LabPage lab={lab} client:only="react" />}
  {rest === "android" && <OverviewPage client:only="react" />}
  {rest === "android/analytics" && <AnalyticsPage client:only="react" />}
  {rest === "android/console" && <ConsolePage client:only="react" />}
  {rest === "android/providers" && <ProvidersPage client:only="react" />}
  {rest === "android/sitemap" && <SitemapPage client:only="react" />}
  {rest === "android/workflows" && <WorkflowsPage client:only="react" />}
</Base>
